# ===========================================
# Academy Management System - Backend Config
# ===========================================

# Server
PORT=4000
NODE_ENV=development

# Test login — lets a client skip Firebase by sending an x-dev-user-email
# header naming the user to sign in as. OFF unless set to exactly "true".
# NEVER set this on an internet-reachable deployment: without DEV_SECRET it
# lets anyone impersonate any account, including admins.
ENABLE_TEST_LOGIN=true
# Optional second gate. When set, every bypass request must also send a
# matching x-dev-secret header. Required if you enable test login anywhere
# other than a local machine (e.g. a staging demo).
# DEV_SECRET=

# Background jobs. ON unless set to exactly "true" here, so production keeps
# running them without any extra config. Turn it OFF on a local machine: the
# jobs write (notifications, front-desk alerts, run bookkeeping), and the
# class reminder fires every five minutes from the moment the server boots.
DISABLE_CRON=true

# Database (PostgreSQL via Neon or local)
# Point this at your OWN dev branch, never at the production database — a local
# server writes to whatever it is given. In Neon: Branches → New branch from
# `main`, then copy that branch's pooled and direct strings in here.
# If using Neon with PgBouncer pooling:
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection — required by Prisma Migrate (advisory locks not supported by PgBouncer)
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Firebase Admin SDK
# Download your service account key from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# ── Email ────────────────────────────────────────────────────────────────
# Four transports exist; email.service.js uses the first one fully configured.
#
# 1. GMAIL API (preferred, and the only one that works in production).
#    Sends over HTTPS as the academy's own mailbox. Render blocks outbound
#    SMTP, and Resend refuses to send until a domain is verified — this needs
#    neither. Mint the refresh token once with:  npm run gmail:auth
#    (that script prints the Google Cloud Console steps if the ids are missing).
GMAIL_USER="your-academy-inbox@gmail.com"
GMAIL_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-oauth-client-secret"
GMAIL_REFRESH_TOKEN="the-token-printed-by-npm-run-gmail:auth"
#
# 2. BREVO (HTTPS, no DNS). Verify the sending address in Brevo -> Senders;
#    they mail it a confirmation link, so a plain @gmail.com address works.
#    Caveat: SPF/DKIM sign for Brevo and can never align with gmail.com, so
#    expect some messages in spam. Free plan sends 300/day.
BREVO_API_KEY="xkeysib-your-brevo-api-key"
#
# 3. RESEND (HTTPS, but dead until a sending domain is verified in Resend).
# RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_FROM="Love Learning Explorers <hello@your-verified-domain.com>"
#
# 4. GMAIL SMTP — local development only; Render blocks it on every port.
#    Google Account → Security → 2-Step Verification (must be ON) → App passwords.
# GMAIL_APP_PASSWORD="your-16-character-app-password"
#
# Logo for the HTTP transports (2 and 3), which cannot attach it inline. Must be
# a public https URL — Gmail and Outlook drop data: URIs. Defaults to the
# deployed app's own /logo.png, so set this only if the frontend moves.
# EMAIL_LOGO_URL="https://lovelearning-three.vercel.app/logo.png"

# AI assistant + lesson-plan summaries.
# AI_PROVIDER=gemini  → Google Gemini API (free tier; needs GEMINI_API_KEY)
# AI_PROVIDER=ollama  → local Ollama (free, but only while THIS machine is on)
# AI_PROVIDER=claude  → Anthropic API (needs ANTHROPIC_API_KEY)
#
# Use "gemini" for anything deployed. Ollama listens on localhost, so a hosted
# API (Render) has nothing to talk to and every summary falls back to plain text.
AI_PROVIDER="gemini"
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Only read when AI_PROVIDER=gemini. Has a working default. Google retires these
# names — a 404 saying the model "is no longer available" names its replacement.
# Deliberately a "-lite" model, not the flagship "-flash": the flagship reasons
# before answering (slow, and needs a high maxOutputTokens just to out-spend its
# own thinking budget); free-tier quota is also per model, so lite leaves the
# flagship's daily allowance untouched.
# GEMINI_MODEL="gemini-3.5-flash-lite"
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_here"
# Only read when AI_PROVIDER=ollama. Both have working defaults, so leave them
# out unless Ollama runs somewhere other than this machine or on another model.
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"

# SMS via Twilio. While SMS_PROVIDER is unset every send is a logged no-op (the
# in-app notification still lands) — nothing breaks by leaving this out.
# Get the account SID + auth token from the Twilio console, and buy a phone
# number there (US numbers need A2P 10DLC registration before they can send
# to US mobiles — Twilio's console walks through that once a number is bought).
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM_NUMBER="+15551234567"

# Frontend URL (for CORS & Stripe redirect)
FRONTEND_URL="http://localhost:5173"

# Where a notification email should send the reader. Without it those emails
# carry no action link at all — set it to the same place as FRONTEND_URL unless
# the app is reached through a different public address.
APP_URL="http://localhost:5173"

# This API's own public origin — the process cannot discover the address the
# outside world reaches it on. Invitation links point here (/api/auth/activate/…)
# so they can outlive the one hour Firebase gives its own password links, which
# is not configurable. Unset, invites silently fall back to that one-hour link:
# fine locally, useless for an email someone opens after lunch.
PUBLIC_API_URL="http://localhost:5000"

# JWT Secret (backup, Firebase handles primary auth)
JWT_SECRET="your-fallback-jwt-secret-change-this"

# Google Drive — also the durable storage for marketing photos and chat
# attachments (Render's local disk is wiped on every restart/redeploy).
#
# Mint this with `npm run gmail:auth`: it is the same token as
# GMAIL_REFRESH_TOKEN, consented for the Drive scope too. Without it the
# server falls back to the service account below, which owns whatever it
# uploads and has a storage quota of zero on a non-Workspace account — every
# upload fails. That is how 35 marketing photos were lost.
DRIVE_REFRESH_TOKEN="same-value-as-GMAIL_REFRESH_TOKEN"

# Legacy service-account path. Cannot actually store anything (see above);
# leave unset unless an old deployment still depends on it.
DRIVE_CLIENT_EMAIL="your-google-service-account@your-project.iam.gserviceaccount.com"
DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The folder each upload type lands in — the last path segment of its Drive URL.
DRIVE_MARKETING_FOLDER_ID="your-google-drive-folder-id"
DRIVE_CHAT_FOLDER_ID="your-google-drive-folder-id-for-chat-attachments"
DRIVE_WAIVERS_FOLDER_ID="your-google-drive-folder-id-for-signed-waivers"
# Optional. Snack cabinet photos fall back to the marketing folder when this
# is unset, so leaving it blank still works — it only keeps the two apart.
DRIVE_SNACKS_FOLDER_ID=""
# Optional too. Academy Feed photos and videos fall back to the marketing
# folder when this is unset. Before it existed they were written to local disk
# only, so a post's pictures vanished with the next container restart.
DRIVE_ANNOUNCEMENTS_FOLDER_ID=""

# Keep-alive del plan free de Render: el server se pinguea solo para no
# dormirse, pero solo dentro de esta ventana (hora de la academia, no UTC).
# Despierto 24/7 son ~744h/mes contra un tope de 750. La ventana por defecto
# 6-22 cubre todos los crons (el primero 06:00, el ultimo 21:05) y baja el
# consumo a ~496h. Un servicio dormido no puede despertarse solo: hace falta
# un ping externo (cron-job.org) a las ~05:50 para el arranque de la manana.
KEEP_ALIVE_START_HOUR=6
KEEP_ALIVE_END_HOUR=22

# Google Form intake — the shared secret that lets the Apps Script post form
# responses in (it runs as a Google account and has no Firebase token, so this
# header is its only credential). Use the SAME value here and in the script's
# Project Settings → Script Properties. Without it the intake endpoint refuses
# every request. Generate one with: openssl rand -hex 32
FORM_INTAKE_SECRET="a-long-random-string"

# Wave accounting (optional — income sync). Register an app at
# https://developer.waveapps.com. The integration stays off and the admin UI
# explains what is missing until id, secret and redirect URI are all set.
# The redirect URI must match the one registered on the Wave app exactly:
#   https://<backend-host>/api/integrations/wave/callback
# WAVE_CLIENT_ID="your-wave-oauth-client-id"
# WAVE_CLIENT_SECRET="your-wave-oauth-client-secret"
# WAVE_REDIRECT_URI="http://localhost:4000/api/integrations/wave/callback"
# Encrypts the stored Wave tokens (AES-256-GCM). Falls back to JWT_SECRET, but
# set its own value in production so rotating one does not lock out the other.
# WAVE_TOKEN_SECRET=
# Endpoint and scopes have working defaults in config/wave.js — override only
# if Wave moves the GraphQL URL or the app needs a different scope set.
# WAVE_GRAPHQL_URL=
# WAVE_SCOPES=
