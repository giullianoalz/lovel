# ===========================================
# Academy Management System - Backend Config
# ===========================================

# Server
PORT=4000
NODE_ENV=development

# Test login — lets a client skip Firebase by sending an x-dev-user-email
# header naming the user to sign in as. OFF unless set to exactly "true".
# NEVER set this on an internet-reachable deployment: without DEV_SECRET it
# lets anyone impersonate any account, including admins.
ENABLE_TEST_LOGIN=true
# Optional second gate. When set, every bypass request must also send a
# matching x-dev-secret header. Required if you enable test login anywhere
# other than a local machine (e.g. a staging demo).
# DEV_SECRET=

# Background jobs. ON unless set to exactly "true" here, so production keeps
# running them without any extra config. Turn it OFF on a local machine: the
# jobs write (notifications, front-desk alerts, run bookkeeping), and the
# class reminder fires every five minutes from the moment the server boots.
DISABLE_CRON=true

# Database (PostgreSQL via Neon or local)
# Point this at your OWN dev branch, never at the production database — a local
# server writes to whatever it is given. In Neon: Branches → New branch from
# `main`, then copy that branch's pooled and direct strings in here.
# If using Neon with PgBouncer pooling:
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection — required by Prisma Migrate (advisory locks not supported by PgBouncer)
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Firebase Admin SDK
# Download your service account key from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Email (Gmail SMTP) — used instead of a transactional provider because Resend
# needs a verified sending domain, which is stuck behind the registrar's DNS
# editor. An App Password sidesteps that: Google Account → Security → 2-Step
# Verification (must be ON) → App passwords → generate one for "Mail".
GMAIL_USER="your-academy-inbox@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"

# AI Chat Assistant (optional — falls back to Ollama if not set)
# AI_PROVIDER=claude  → uses Anthropic API (needs key below)
# AI_PROVIDER=ollama  → uses local Ollama (free, no key needed)
AI_PROVIDER="claude"
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_here"
# Only read when AI_PROVIDER=ollama. Both have working defaults, so leave them
# out unless Ollama runs somewhere other than this machine or on another model.
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.1:8b"

# SMS. No provider is wired up yet: sms.service.js is a seam, and while this is
# unset every send is a logged no-op (the in-app notification still lands).
# Only set it once `deliver` in that file actually talks to a provider.
# SMS_PROVIDER="twilio"

# Frontend URL (for CORS & Stripe redirect)
FRONTEND_URL="http://localhost:5173"

# Where a notification email should send the reader. Without it those emails
# carry no action link at all — set it to the same place as FRONTEND_URL unless
# the app is reached through a different public address.
APP_URL="http://localhost:5173"

# This API's own public origin — the process cannot discover the address the
# outside world reaches it on. Invitation links point here (/api/auth/activate/…)
# so they can outlive the one hour Firebase gives its own password links, which
# is not configurable. Unset, invites silently fall back to that one-hour link:
# fine locally, useless for an email someone opens after lunch.
PUBLIC_API_URL="http://localhost:5000"

# JWT Secret (backup, Firebase handles primary auth)
JWT_SECRET="your-fallback-jwt-secret-change-this"

# Google Drive — also the durable storage for marketing photos and chat
# attachments (Render's local disk is wiped on every restart/redeploy).
# Provide the Service Account credentials here for Google Drive upload
DRIVE_CLIENT_EMAIL="your-google-service-account@your-project.iam.gserviceaccount.com"
DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
DRIVE_MARKETING_FOLDER_ID="your-google-drive-folder-id"
DRIVE_CHAT_FOLDER_ID="your-google-drive-folder-id-for-chat-attachments"
DRIVE_WAIVERS_FOLDER_ID="your-google-drive-folder-id-for-signed-waivers"

# Google Form intake — the shared secret that lets the Apps Script post form
# responses in (it runs as a Google account and has no Firebase token, so this
# header is its only credential). Use the SAME value here and in the script's
# Project Settings → Script Properties. Without it the intake endpoint refuses
# every request. Generate one with: openssl rand -hex 32
FORM_INTAKE_SECRET="a-long-random-string"

# Wave accounting (optional — income sync). Register an app at
# https://developer.waveapps.com. The integration stays off and the admin UI
# explains what is missing until id, secret and redirect URI are all set.
# The redirect URI must match the one registered on the Wave app exactly:
#   https://<backend-host>/api/integrations/wave/callback
# WAVE_CLIENT_ID="your-wave-oauth-client-id"
# WAVE_CLIENT_SECRET="your-wave-oauth-client-secret"
# WAVE_REDIRECT_URI="http://localhost:4000/api/integrations/wave/callback"
# Encrypts the stored Wave tokens (AES-256-GCM). Falls back to JWT_SECRET, but
# set its own value in production so rotating one does not lock out the other.
# WAVE_TOKEN_SECRET=
# Endpoint and scopes have working defaults in config/wave.js — override only
# if Wave moves the GraphQL URL or the app needs a different scope set.
# WAVE_GRAPHQL_URL=
# WAVE_SCOPES=
