// One row per scheduled job registered in server/src/jobs/cron.jobs.js,
// recording when it last completed. node-cron keeps no history and only fires
// forward from process start, so without this a job whose slot passed while the
// server was down (deploy, crash, Render spin-down) is simply skipped. At boot
// the catch-up pass compares `lastRunAt` against the job's last expected fire
// time and re-runs whatever was missed.
//
//   lastRunAt  — start of the last *successful* run; null means never completed.
//                A failed run deliberately leaves it alone so the next boot retries.
//   lastStatus — "ok" | "error" | "seeded" (row created at boot with no history)
model CronJobRun {
  id         String    @id @default(uuid()) @db.Uuid
  jobName    String    @unique @map("job_name") @db.VarChar(100)
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastStatus String    @default("ok") @map("last_status") @db.VarChar(20)
  lastError  String?   @map("last_error")
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cron_job_runs")
}

// What a self-registered family asked for, per child.
//
// A family that signs itself up gets a working account immediately, but its
// children are parked as INACTIVE until staff place them in a class. This row
// is what staff act on: it carries the child's stated interests so the
// placement screen opens with the request already filled in, and it is the only
// thing standing between "someone filled in a form" and a student who shows up
// on rosters, invoices and payroll.
model EnrollmentApplication {
  id            String            @id @default(uuid()) @db.Uuid
  familyId      String            @map("family_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  submittedById String            @map("submitted_by_id") @db.Uuid
  status        ApplicationStatus @default(PENDING)
  // Free-form modality tags the parent ticked (one-on-one, group, virtual,
  // homeschool, pods…). Deliberately not an enum: the offering changes faster
  // than a migration, and nothing branches on these — staff read them.
  interests     String[]          @default([])
  ixlPlan       IxlPlan           @default(NONE)
  // Most families here are on a Step Up scholarship, so knowing this up front
  // decides whether the first invoice goes to the parent or into the EMA run.
  scholarship   Boolean           @default(false)
  parentNotes   String?           @map("parent_notes")
  staffNotes    String?           @map("staff_notes")
  reviewedById  String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  family        Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  student       User              @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy   User              @relation("SubmittedApplications", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([familyId])
  @@map("enrollment_applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED

  @@map("application_status")
}

// A parent's signature on the liability waiver, one row per child.
//
// The names are snapshotted rather than read through the relations: this is a
// legal record of what the parent saw and agreed to at that moment, so a later
// rename of the account must not silently rewrite a signed document. Same
// reason for documentVersion — if the waiver text is ever revised, existing
// rows keep pointing at the wording that was actually on screen.
//
// The signature is the raw PNG the parent drew, kept inline because it is a few
// kilobytes and losing it would void the record. The downloadable PDF is still
// built from this row on demand — driveFileId is a second copy, archived to
// Drive at signing time so a signed contract survives even if this row is ever
// only read from a stale replica or exported without it.
model LiabilityWaiver {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @unique @map("student_id") @db.Uuid
  familyId        String   @map("family_id") @db.Uuid
  signedById      String   @map("signed_by_id") @db.Uuid
  minorName       String   @map("minor_name") @db.VarChar(255)
  parentName      String   @map("parent_name") @db.VarChar(255)
  signatureData   String   @map("signature_data")
  documentVersion String   @default("2026-08") @map("document_version") @db.VarChar(20)
  // The exact title + section text the parent had on screen when they signed
  // — { title, sections }, the same shape GET /waivers/document returns.
  // documentVersion alone is a label, not a document: without the actual
  // wording captured here, regenerating this waiver's PDF after the template
  // is later edited would silently attach today's wording to a signature that
  // was given for yesterday's. Null only for rows signed before this column
  // existed, where the PDF falls back to the current template.
  documentSnapshot Json?   @map("document_snapshot")
  // The waiver's own opt-out: checked, the parent wrote "No Photos" on the
  // line the paper form offers instead of a blanket refusal of the whole
  // release. Marketing needs this surfaced, not just recorded.
  photoOptOut     Boolean  @default(false) @map("photo_opt_out")
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  // Set once the signed PDF has been archived to Drive. Null just means the
  // archive step hasn't run yet (or Drive wasn't configured at signing time) —
  // it never blocks signing itself, and the app-generated PDF works either way.
  driveFileId     String?  @map("drive_file_id") @db.VarChar(128)
  signedAt        DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)
  student         User     @relation("StudentWaiver", fields: [studentId], references: [id], onDelete: Cascade)
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  signedBy        User     @relation("SignedWaivers", fields: [signedById], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("liability_waivers")
}

