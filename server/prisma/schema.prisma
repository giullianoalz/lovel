generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  firebaseUid            String                    @unique @map("firebase_uid") @db.VarChar(128)
  email                  String                    @unique @db.VarChar(255)
  fullName               String                    @map("full_name") @db.VarChar(255)
  // Primary role: decides where this account lands after signing in, and stays
  // the single answer for the many places that only need one.
  role                   UserRole
  // Extra hats the same person wears. Staff who are also parents here (a
  // teacher enrolling her own children) can't be two accounts: sign-in is tied
  // 1:1 to a Firebase email. Permission checks read primary + secondary
  // together via hasRole(); see server/src/utils/roles.js.
  secondaryRoles         UserRole[]                @default([]) @map("secondary_roles")
  phone                  String?                   @db.VarChar(20)
  avatarUrl              String?                   @map("avatar_url")
  status                 UserStatus                @default(ACTIVE)
  age                    Int?
  // Real date of birth. `age` above is a plain integer that goes stale every
  // year; this is what the directory shows and what age should be derived from
  // once every student has one backfilled.
  birthday               DateTime?                 @db.Date
  allergies              String?
  // School grade the student is in: "K" or "1st".."12th". Free text rather than
  // an enum because it is a label we show, not something we branch on, and it
  // has to survive a student arriving mid-year from a school that numbers
  // things differently.
  gradeLevel             String?                   @map("grade_level") @db.VarChar(10)
  snackAuthorized        Boolean                   @default(false) @map("snack_authorized")
  snackPunches           Int                       @default(0) @map("snack_punches")
  seashells              Int                       @default(0) @map("prize_points")
  // Step Up for Students' own internal ID for this student (from the "STUDENT
  // ID" column of their CSV export) — stable per student across submissions,
  // so once learned it's a much more reliable EMA match than comparing names.
  emaStudentId           String?                   @unique @map("ema_student_id") @db.VarChar(50)
  // When an admin last emailed this person their "set your password" invite.
  // Accounts are created by staff (imported or added by hand) before the person
  // can sign in, so this is what tells the directory "invited, waiting on them"
  // apart from "never invited".
  invitedAt              DateTime?                 @map("invited_at") @db.Timestamptz(6)
  // The invite handle we hand out, as a SHA-256 digest — the raw token is a
  // credential and is shown once, at the moment the invite is issued.
  //
  // It exists because Firebase's own password links die after an hour and that
  // is not configurable (there is no expiry field anywhere in the Identity
  // Platform project config). An hour is useless for an invitation someone
  // opens after lunch, so the long-lived handle is ours and redeeming it mints
  // a fresh Firebase link at click time.
  inviteTokenHash        String?                   @unique @map("invite_token_hash") @db.VarChar(64)
  inviteTokenExpiresAt   DateTime?                 @map("invite_token_expires_at") @db.Timestamptz(6)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  baseSalary             Decimal?                  @map("base_salary") @db.Decimal(10, 2)
  // Whether `baseSalary` is the yearly figure or the monthly one. Salaried
  // staff are hired on an annual number ($63,000/yr), and that is the number
  // everyone says out loud — storing a divided-down $5,250 would mean nobody
  // could find their own salary on the screen. Payroll runs monthly, so it
  // divides at read time instead.
  salaryPeriod           SalaryPeriod              @default(MONTHLY) @map("salary_period")
  // Paid per hour taught, not per session: a 50-minute and a 3-hour class are
  // not the same work, and a flat per-session rate paid them the same. This is
  // the fallback rate — a category override in TeacherPayRate wins over it.
  hourlyRate             Decimal?                  @map("hourly_rate") @db.Decimal(10, 2)
  // "She gets $17.50 an hour, whatever she's doing." Some people are hired on
  // one number and the category rates must not quietly pay them more for
  // covering a class. With this set, `hourlyRate` above wins over every
  // category rate — only a rate typed onto a single calendar entry beats it,
  // because that is somebody deliberately saying "this one is different".
  flatRateOnly           Boolean                   @default(false) @map("flat_rate_only")
  accommodationNotes     String?                   @map("accommodation_notes")
  medicalNotes           String?                   @map("medical_notes")
  // Back-office jottings about this student: scholarship paperwork, the shape
  // of what the family bought ("Flex 16", "Indiv 8"), anything staff need to
  // remember while invoicing.
  //
  // Separate from `accommodationNotes` because that field is teacher-facing —
  // it badges the class roster — and billing shorthand landing there reads to a
  // teacher as "this child has an accommodation". ADMIN only; every student
  // response strips it for anyone else (see students.controller.js).
  staffNotes             String?                   @map("staff_notes")
  // Staff-set "no photos" flag, independent of the waiver's own photoOptOut.
  // Covers a request that comes in after the waiver was already signed (or a
  // family with no waiver on file yet) — front desk and marketing both need a
  // single source of truth for "don't post this kid," not two.
  noPhotosOverride       Boolean                   @default(false) @map("no_photos_override")
  authoredAnnouncements  Announcement[]
  reviewedAnnouncements  Announcement[]      @relation("AnnouncementReviewer")
  attendance             Attendance[]
  doorEventsAsStudent    AttendanceEvent[]         @relation("DoorEventStudent")
  doorEventsRecorded     AttendanceEvent[]         @relation("DoorEventStaff")
  behaviorLogsAsStudent  BehaviorLog[]             @relation("StudentBehaviors")
  behaviorLogsAsTeacher  BehaviorLog[]             @relation("TeacherBehaviors")
  sentMessages           ChatMessage[]
  chatParticipations     ChatParticipant[]
  enrollments            ClassEnrollment[]
  fitReportsAsReviewer   ClassFitReport[]          @relation("ReviewerFitReports")
  fitReportsAsStudent    ClassFitReport[]          @relation("StudentFitReports")
  fitReportsAsTeacher    ClassFitReport[]          @relation("TeacherFitReports")
  taughtClasses          Class[]                   @relation("TeacherClasses")
  coTaughtClasses        Class[]                   @relation("ClassCoTeachers")
  familyMembers          FamilyMember[]
  marketingSubmissions   MarketingSubmission[]     @relation("TeacherSubmissions")
  materials              Material[]
  notifPreferences       NotificationPreference[]
  notifications          Notification[]
  recordedPayments       Payment[]                 @relation("RecordedByUser")
  priorityHolds          PriorityHold[]
  prizeHistory           PrizeHistory[]
  registrationReqs       RegistrationRequest[]
  regAlertsAsReporter    ClassAlert[]              @relation("ReporterAlerts")
  regAlertsAsResolver    ClassAlert[]              @relation("ResolverAlerts")
  regAlertsAsStudent     ClassAlert[]              @relation("StudentAlerts")
  scholarships           ScholarshipDisbursement[]
  snackPurchases         SnackPurchase[]
  transactions           Transaction[]
  waitlistEntries        WaitlistEntry[]
  fcmToken               String?                   @map("fcm_token")
  quietHoursStart        String?                   @map("quiet_hours_start") @db.VarChar(10)
  quietHoursEnd          String?                   @map("quiet_hours_end") @db.VarChar(10)
  quietHoursFullDays     Int[]                     @default([]) @map("quiet_hours_full_days")
  autoResponderMessage   String?                   @map("auto_responder_message")
  announcementReads      AnnouncementRead[]
  announcementComments   AnnouncementComment[]
  medicalLogsAsStudent   MedicalLog[]              @relation("StudentMedicalLogs")
  medicalLogsAsTeacher   MedicalLog[]              @relation("TeacherMedicalLogs")
  medicalLogsAsReviewer  MedicalLog[]              @relation("ReviewerMedicalLogs")
  lessonPlans            LessonPlan[]              @relation("TeacherLessonPlans")
  supplyItems            SupplyItem[]
  timeOffRequests        TimeOffRequest[]
  payRates               TeacherPayRate[]
  workShifts             WorkShift[]               @relation("StaffShifts")
  shiftsScheduled        WorkShift[]               @relation("ShiftScheduledBy")
  sessionPayApprovals    Session[]                 @relation("SessionPayApprovals")
  sessionAbsences        Session[]                 @relation("SessionAbsences")
  sessionsTaught         Session[]                 @relation("SessionTeacher")
  shiftAbsences          WorkShift[]               @relation("ShiftAbsences")
  chargeOverrides        SessionChargeOverride[]   @relation("StudentChargeOverrides")
  chargeOverridesCreated SessionChargeOverride[]   @relation("ChargeOverridesCreated")
  spaceReservations      SpaceReservation[]
  tempPickupAuths        TempPickupAuth[]
  pickupAuthsAsStudent   TempPickupAuth[]          @relation("PickupAuthStudent")
  assignments            Assignment[]              @relation("TeacherAssignments")
  closuresDeclared       AcademyClosure[]          @relation("ClosuresDeclared")
  grades                 Grade[]                   @relation("StudentGrades")
  cancellationsAsStudent SessionCancellation[]     @relation("StudentCancellations")
  cancellationsReported  SessionCancellation[]     @relation("CancelledByStaff")
  cancellationsResolved  SessionCancellation[]     @relation("ResolvedByStaff")
  snackReloadsAsStudent  SnackReloadRequest[]      @relation("SnackReloadStudent")
  recurringCharges       RecurringCharge[]         @relation("RecurringChargeStudent")
  recurringChargesCreated RecurringCharge[]        @relation("RecurringChargeCreatedBy")
  snackReloadsDecided    SnackReloadRequest[]      @relation("SnackReloadDecidedBy")
  snackReloadsFulfilled  SnackReloadRequest[]      @relation("SnackReloadFulfilledBy")
  applicationsAsStudent  EnrollmentApplication[]   @relation("StudentApplications")
  applicationsSubmitted  EnrollmentApplication[]   @relation("SubmittedApplications")
  applicationsReviewed   EnrollmentApplication[]   @relation("ReviewedApplications")
  liabilityWaiver        LiabilityWaiver?          @relation("StudentWaiver")
  waiversSigned          LiabilityWaiver[]         @relation("SignedWaivers")

  @@map("users")
}

model Family {
  id           String                    @id @default(uuid()) @db.Uuid
  name         String                    @db.VarChar(255)
  // Residential address, asked on the registration form. Lives on the family
  // rather than the user because siblings share a household.
  address      String?
  // The household's standing check-in QR — the one a parent keeps on their
  // phone and shows at the door every day. Unlike TempPickupAuth (one named
  // person, one date, and only ever a release) this never expires, because the
  // family arriving is not an exception that needs authorising.
  //
  // Nullable: minted the first time the portal is asked for it, so the import
  // of 64 existing households didn't have to be rewritten. Rotating it is a
  // matter of writing a new value — the old QR stops resolving at once.
  checkInCode  String?                   @unique @map("check_in_code") @db.VarChar(64)
  tags         String[]                  @default([])
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  members      FamilyMember[]
  invoices     Invoice[]
  payments     Payment[]
  scholarships ScholarshipDisbursement[]
  transactions Transaction[]
  snackReloads SnackReloadRequest[]
  applications EnrollmentApplication[]
  recurringCharges RecurringCharge[]
  liabilityWaivers LiabilityWaiver[]

  @@map("families")
}

/**
 * A charge that comes back every month on its own — an IXL membership, a snack
 * card the family tops up, anything billed on a standing arrangement.
 *
 * This is the *instruction*, not the money. Each month a job turns it into one
 * ordinary Transaction, which is what the family's balance and invoices are
 * built from. Keeping the two apart is what lets an admin pause or re-price
 * the arrangement without rewriting history: last month's charge stays exactly
 * as it was billed.
 *
 * Deliberately monthly-only. Every standing charge the academy actually has is
 * monthly, and a general recurrence engine (weekly, "every 3rd Tuesday") is a
 * lot of machinery — plus a lot of ways to be wrong about money — for a case
 * nobody has yet.
 */
model RecurringCharge {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  // Optional: a charge can belong to one child (IXL for the older sibling) or
  // to the household (a snack card the family shares).
  studentId   String?   @map("student_id") @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  description String
  // 1–31. A month that is too short bills on its last day rather than skipping:
  // "the 31st" on a family's arrangement means end of month, not "not February".
  dayOfMonth  Int       @map("day_of_month")
  startDate   DateTime  @map("start_date") @db.Date
  // Null runs until somebody stops it. An arrangement that ends at a known date
  // (a term) sets this so nobody has to remember to switch it off.
  endDate     DateTime? @map("end_date") @db.Date
  // Paused rather than deleted: the history stays attached and it can be
  // resumed without retyping the arrangement.
  active      Boolean   @default(true)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  family      Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  student     User?         @relation("RecurringChargeStudent", fields: [studentId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("RecurringChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([familyId])
  @@index([active])
  @@map("recurring_charges")
}

model FamilyMember {
  id                 String  @id @default(uuid()) @db.Uuid
  familyId           String  @map("family_id") @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  role               String? @db.VarChar(50)
  isInvoiceRecipient Boolean @default(false) @map("is_invoice_recipient")
  family             Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Class {
  id               String                @id @default(uuid()) @db.Uuid
  name             String                @db.VarChar(255)
  subject          String?               @db.VarChar(100)
  teacherId        String?               @map("teacher_id") @db.Uuid
  type             ClassType             @default(IN_PERSON)
  groupType        GroupType             @default(REGULAR) @map("group_type")
  // A term carries exactly two rates (regular / anchored), which covers the
  // Discovery Coves and nothing else: Biology, Algebra 1 and the 8th grade
  // programme are three more prices in the same period. When set, this wins
  // over whichever term rate groupType would have selected. Left null, the
  // class prices exactly as before.
  priceOverride    Decimal?              @map("price_override") @db.Decimal(10, 2)
  meetingUrl       String?               @map("meeting_url")
  maxStudents      Int                   @default(10) @map("max_students")
  status           String                @default("active") @db.VarChar(20)
  termId           String?               @map("term_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  enrollments      ClassEnrollment[]
  classFitReports  ClassFitReport[]
  teacher          User?                 @relation("TeacherClasses", fields: [teacherId], references: [id])
  coTeachers       User[]                @relation("ClassCoTeachers")
  term             RegistrationTerm?     @relation("TermClasses", fields: [termId], references: [id])
  priorityHolds    PriorityHold[]
  firstChoiceReqs  RegistrationRequest[] @relation("FirstChoice")
  secondChoiceReqs RegistrationRequest[] @relation("SecondChoice")
  sessions         Session[]
  waitlistEntries  WaitlistEntry[]
  lessonPlans      LessonPlan[]
  assignments      Assignment[]

  @@map("classes")
}

/// What one student pays for one meeting, when it isn't the meeting's price.
///
/// `Session.chargeAmount` is a single number for everybody on the roster, which
/// is right until somebody's fee already covers the room they're sitting in. The
/// 8th grade programme runs 10:00–17:00 Mon–Thu for $2,000 a quarter, and those
/// students spend that day inside the same coves and electives everyone else is
/// charged $400 and $130 for. Billing them again for a room their tuition
/// already bought is the mistake this exists to prevent — it was worth $3,050
/// across two students in the first term it applied.
///
/// An amount, not a boolean, because "this one is free for her" and "she pays a
/// reduced $50" are the same decision at different numbers. 0 means charged
/// nothing; no row at all means the meeting's own price applies.
///
/// Keyed by (session, student) so it survives the roster changing underneath it:
/// a student added to a cove later still has to be exempted deliberately, which
/// is the safe direction to fail.
model SessionChargeOverride {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  // Why this student is priced differently — shown next to the money on the
  // review screen, because an exemption nobody can explain is one nobody can
  // defend months later.
  reason      String?  @db.VarChar(255)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User    @relation("StudentChargeOverrides", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ChargeOverridesCreated", fields: [createdById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("session_charge_overrides")
}

model ClassEnrollment {
  id         String    @id @default(uuid()) @db.Uuid
  classId    String    @map("class_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  enrolledAt DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  // The day they came off the roster. `status` says whether they are on it now;
  // this says when they stopped being, which is the only thing that can answer
  // "who was in the room three weeks ago".
  //
  // Without it a session in the past is shown with today's roster: a child
  // enrolled yesterday appears in a class they never attended, and one who left
  // vanishes from the register of the weeks they sat through. Set on unenrol,
  // cleared on re-enrol.
  //
  // Null on every row that predates this column, which reads as "still on the
  // roster" for the active ones and, for the inactive ones, as "left at some
  // unknown point" — see rosterOn(), which shows those on sessions already run
  // rather than erasing a child from meetings they were at.
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  status     String    @default("active") @db.VarChar(20)
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("class_enrollments")
}

model Session {
  id              String                @id @default(uuid()) @db.Uuid
  classId         String                @map("class_id") @db.Uuid
  date            DateTime              @db.Date
  startTime       DateTime              @map("start_time") @db.Time(6)
  endTime         DateTime              @map("end_time") @db.Time(6)
  status          SessionStatus         @default(SCHEDULED)
  // Who actually stood in the room for this hour, once that stops being a
  // question the class can answer.
  //
  // Normally null, and the teacher is whoever the Class says it is — one place
  // to look, and a timetable change carries the whole term with it. That breaks
  // the moment a class changes hands: reading the teacher off the Class moves
  // every hour already taught onto the new person's payslip and off the old
  // one's, rewriting work that was done and, for the months already run, money
  // already paid.
  //
  // So the outgoing teacher is stamped here on every meeting already in the
  // past at the moment of the handover — see updateClass. It is the same
  // reasoning as `paidRate` below: the hour happened under facts that have
  // since changed, and the only way to keep those facts is to write them down
  // while they are still true.
  //
  // Null still means "ask the Class", so nothing scheduled ahead is frozen and
  // every session booked before this column existed keeps behaving as it did.
  teacherId       String?               @map("teacher_id") @db.Uuid
  teacher         User?                 @relation("SessionTeacher", fields: [teacherId], references: [id])
  // A link on THIS meeting only. Algebra 1 meets in person Mon/Wed and online
  // on Tuesday: hanging the Zoom link off the Class would advertise it on all
  // three and families would show up online on the wrong day. Set here, the
  // link exists on the Tuesday session and nowhere else. Left null the meeting
  // is in person, unless the whole Class is VIRTUAL — see resolveMeetingUrl().
  meetingUrl      String?               @map("meeting_url")
  // What kind of work this meeting is, for pay. Chosen on the calendar entry
  // rather than inferred, because the thing that decides the rate is what the
  // teacher was hired to do that hour ("private tutoring", "in-person class"),
  // and no property of the row can tell those apart. Left null, the payroll
  // engine falls back to the old guess — online if there's a meeting link,
  // in person otherwise — so every session booked before this existed keeps
  // paying exactly what it paid.
  payCategoryKey  String?               @map("pay_category_key") @db.VarChar(40)
  // A rate for this one meeting, overriding every other rate. For the one-off:
  // a teacher covering a class at an agreed number, a session someone was paid
  // extra for. Null means "use the normal cascade" — see payroll.service.js.
  payRateOverride Decimal?              @map("pay_rate_override") @db.Decimal(10, 2)
  // The rate this hour was actually worked at, stamped the moment it was
  // confirmed COMPLETED.
  //
  // Without it, pay is whatever the rate says today: give somebody a raise in
  // March and February's payroll silently reprices to the new number. The hour
  // was worked under the old contract, so the old number is the true one, and
  // the only way to keep it is to write it down when the work is confirmed.
  //
  // Null on anything not yet confirmed — those price live, so editing a rate
  // still fixes the hours that haven't been signed off.
  paidRate        Decimal?              @map("paid_rate") @db.Decimal(10, 2)
  // Which step of the cascade produced `paidRate` ("category", "flat", …), kept
  // so the payslip can still explain a frozen rate months later.
  paidRateSource  String?               @map("paid_rate_source") @db.VarChar(20)
  // An admin vouching that this hour was worked, when nobody closed it out.
  //
  // A class is normally confirmed by the teacher: marked complete, register
  // saved. Teachers forget, and the hour was still taught — so payroll used to
  // flag it and then refuse to pay it, leaving the only fix outside the system
  // (pay them by hand, and hope somebody remembers). This is the way back in:
  // an admin says "I know this ran, pay it", and the session becomes payable
  // without a register ever existing.
  //
  // Who and when, not a boolean: this is somebody authorising money against no
  // evidence, so the record has to name them. Null means nobody has vouched.
  payApprovedById String?               @map("pay_approved_by") @db.Uuid
  payApprovedAt   DateTime?             @map("pay_approved_at") @db.Timestamptz(6)
  payApprovedBy   User?                 @relation("SessionPayApprovals", fields: [payApprovedById], references: [id])
  // The teacher did not turn up, so this hour is not paid.
  //
  // Pay now accrues from the calendar: once the hour has passed it is owed,
  // and nobody is asked to confirm it. This is the one way out, and it lives
  // on the calendar entry because that is where the person who knows about the
  // absence already is. Setting it takes the hour off payroll immediately;
  // clearing it puts it back.
  //
  // Who, when and why rather than a boolean: this removes money from somebody's
  // payslip, so the record has to name whoever did it and what they said.
  absentAt        DateTime?             @map("absent_at") @db.Timestamptz(6)
  absentById      String?               @map("absent_by") @db.Uuid
  absentReason    String?               @map("absent_reason") @db.VarChar(255)
  absentBy        User?                 @relation("SessionAbsences", fields: [absentById], references: [id])
  // What this one meeting costs a family, charged per enrolled student.
  //
  // The other half of `payRateOverride` above: that is what the hour pays the
  // teacher, this is what it bills the client, and the two are unrelated
  // numbers that happen to hang off the same calendar entry.
  //
  // This is how the academy actually bills — the price goes on the first week
  // of a class and every enrolled family owes it. Null means the meeting raises
  // nothing, which is what all the other weeks stay. 0 is a real price ("this
  // one is free"), deliberately distinct from null.
  //
  // The term-based quarterly run prices the same classes and is deliberately
  // not executed; running both charges every family twice, and no constraint
  // spans the two. See quarterlyBilling.service.js.
  //
  // Setting it does not charge anybody. It marks what the meeting costs; an
  // admin reviews the pending ones and approves them into the ledger — see
  // sessionCharges.service.js.
  chargeAmount    Decimal?              @map("charge_amount") @db.Decimal(10, 2)
  // What the family sees on the invoice line. Falls back to the class name.
  chargeNote      String?               @map("charge_note") @db.VarChar(255)
  charges         Transaction[]         @relation("SessionCharges")
  chargeOverrides SessionChargeOverride[]
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  attendance      Attendance[]
  doorEvents      AttendanceEvent[]
  behaviorLogs    BehaviorLog[]
  classFitReports ClassFitReport[]
  materials       SessionMaterial[]
  notes           SessionNote[]
  cancellations   SessionCancellation[]
  class           Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([date])
  @@index([teacherId])
  @@map("sessions")
}

// Tracks a single student's cancellation of a scheduled session against the
// 48-hour policy: >=48h out is free (auto-resolved, no charge); <48h suggests
// a 50% charge but the admin must review and set the final amount — this
// model IS that review queue, surfaced in Front Desk Alerts.
model SessionCancellation {
  id                     String    @id @default(uuid()) @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  cancelledById          String    @map("cancelled_by") @db.Uuid
  reason                 String?
  hoursBeforeClass       Decimal   @map("hours_before_class") @db.Decimal(6, 2)
  suggestedChargePercent Int       @map("suggested_charge_percent")
  status                 String    @default("PENDING_REVIEW") @db.VarChar(20) // PENDING_REVIEW | RESOLVED
  finalChargePercent     Int?      @map("final_charge_percent")
  chargeAmount           Decimal?  @map("charge_amount") @db.Decimal(10, 2)
  resolvedById           String?   @map("resolved_by") @db.Uuid
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      User          @relation("StudentCancellations", fields: [studentId], references: [id], onDelete: Cascade)
  cancelledBy  User          @relation("CancelledByStaff", fields: [cancelledById], references: [id])
  resolvedBy   User?         @relation("ResolvedByStaff", fields: [resolvedById], references: [id])
  transactions Transaction[]

  @@unique([sessionId, studentId])
  @@index([status])
  @@map("session_cancellations")
}

// One teacher's hourly rate for one kind of work.
//
// A teacher who teaches both in the building and over Zoom is often paid
// differently for each, so a single rate on the User row can't express it. The
// category is decided PER SESSION, not per class: since a class can meet in
// person on Monday and online on Tuesday (see Session.meetingUrl), reading the
// category off the Class would pay the wrong rate for half the week.
//
// Category keys are free-form strings rather than an enum so a new kind of work
// doesn't need a migration; the ones the payroll engine currently produces are
// in PAY_CATEGORIES (payroll.service.js).
model TeacherPayRate {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  category   String   @db.VarChar(40)
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, category])
  @@index([teacherId])
  @@map("teacher_pay_rates")
}

// A kind of work, and what it pays by default.
//
// This is the list an admin actually thinks in: front desk $20, private
// tutoring $30, in-person class $50, planning $20. Putting the rate on the
// category means scheduling somebody for an hour of front desk is all it takes
// to know what that hour costs — nobody has to remember to also set a rate.
//
// A row here is not a permission or a schedule, only a price tag. The two
// built-in keys ONLINE and IN_PERSON are seeded to match what the payroll
// engine used to infer, so pay rates set before categories existed keep
// resolving to the same money.
model PayCategory {
  id          String   @id @default(uuid()) @db.Uuid
  // Stable identifier stored on sessions, shifts and TeacherPayRate rows. Set
  // once, at creation, and never edited: renaming "Front desk" is a label
  // change, but changing its key would orphan every hour already booked to it.
  key         String   @unique @db.VarChar(40)
  label       String   @db.VarChar(80)
  // What an hour of this work pays anyone, unless that person has their own
  // rate for it. Nullable because a category can exist purely to group hours
  // (an unpaid meeting), and because "no rate yet" must be distinguishable
  // from "$0 an hour".
  defaultRate Decimal? @map("default_rate") @db.Decimal(10, 2)
  // Whether this kind of work is teaching (offered on class sessions) or a
  // shift (offered on work shifts). Both lists stay selectable everywhere —
  // this only decides what the pickers suggest first.
  teaching    Boolean  @default(false)
  color       String?  @db.VarChar(20)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active])
  @@map("pay_categories")
}

// Paid hours that aren't a class: reception, planning, a staff meeting, setup.
//
// These can't be Sessions. A Session belongs to a Class, and a Class shows up
// in enrolment, the parent portal and the registration reports — "Front Desk"
// with no students would be wrong in all three. It also can't be paid the way
// sessions are, which require an attendance record to exist: nobody takes
// attendance at the front desk.
//
// So a shift is its own thing: a person, a block of time, and what kind of
// work it was. It appears on the calendar alongside classes and it is paid
// once marked COMPLETED.
model WorkShift {
  id              String          @id @default(uuid()) @db.Uuid
  staffId         String          @map("staff_id") @db.Uuid
  date            DateTime        @db.Date
  // TIME columns, matching Session: the calendar reasons about a day and two
  // clock times, and a timestamptz would drag every shift across a DST border.
  startTime       DateTime        @map("start_time") @db.Time(6)
  endTime         DateTime        @map("end_time") @db.Time(6)
  payCategoryKey  String?         @map("pay_category_key") @db.VarChar(40)
  payRateOverride Decimal?        @map("pay_rate_override") @db.Decimal(10, 2)
  // Stamped when the shift is marked worked — same reason as Session.paidRate:
  // the hour belongs to the contract that was in force when it happened.
  paidRate        Decimal?        @map("paid_rate") @db.Decimal(10, 2)
  paidRateSource  String?         @map("paid_rate_source") @db.VarChar(20)
  status          WorkShiftStatus @default(SCHEDULED)
  title           String?         @db.VarChar(255)
  notes           String?
  createdById     String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // The same escape hatch sessions have: the shift's hour passed, so it is
  // paid, unless somebody says the person was not there. See Session.absentAt.
  absentAt        DateTime?       @map("absent_at") @db.Timestamptz(6)
  absentById      String?         @map("absent_by") @db.Uuid
  absentReason    String?         @map("absent_reason") @db.VarChar(255)

  staff     User  @relation("StaffShifts", fields: [staffId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ShiftScheduledBy", fields: [createdById], references: [id])
  absentBy  User? @relation("ShiftAbsences", fields: [absentById], references: [id])

  @@index([staffId, date])
  @@index([date])
  @@map("work_shifts")
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus @default(PRESENT)
  checkedAt DateTime         @default(now()) @map("checked_at") @db.Timestamptz(6)
  // Stamped by the front desk when a child leaves. Nullable and ignored by the
  // teacher's attendance sheet: still-null on a past session means nobody
  // signed them out, not that they never arrived.
  checkedOutAt DateTime?     @map("checked_out_at") @db.Timestamptz(6)
  // Who the child was released to. Free text rather than a relation: most
  // pickups are by someone with no account here (a grandparent, a neighbour),
  // and the name on the authorisation is the record worth keeping.
  checkedOutTo String?       @map("checked_out_to") @db.VarChar(255)
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance")
}

/**
 * Append-only log of who was where: the door's arrivals and departures, and the
 * teacher's marks on the attendance sheet, each as it happened and with the
 * person who recorded it.
 *
 * Attendance above is *state* — one row per child per session, overwritten. A
 * child who leaves for a dentist appointment and comes back leaves no trace of
 * the trip there: re-checking in clears the departure stamp on purpose, because
 * the sheet has to answer "is this child here now". This table is the other
 * question, the one that gets asked days later: who let them out, at what time,
 * and on whose word.
 *
 * Nothing reads it to make a decision, and nothing should. It is a record.
 */
model AttendanceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  // IN, OUT, or MARK. The first two are movements somebody witnessed at the
  // door. MARK is the teacher filling in the sheet, which is a decision rather
  // than a movement — recorded as an IN it would invent an arrival at whatever
  // time the sheet happened to be saved, sitting in the record next to the
  // door's real stamps as though it were one.
  direction String   @db.VarChar(10)
  // The status written (PRESENT / LATE on an arrival, any of the four on a
  // MARK); null on a departure.
  status    AttendanceStatus?
  // How it was done: MANUAL (someone tapped a name on the board), FAMILY_QR
  // (the household code was shown), PICKUP_QR (a temporary authorisation was
  // scanned), SHEET (the teacher's attendance sheet). This is the difference
  // between "the desk says he arrived" and "the family presented their code",
  // and it is the whole reason to log.
  source    String   @db.VarChar(20)
  // The staff member at the door. Nullable so the row survives their account
  // being deleted — losing the log because someone left the academy would
  // defeat the point of keeping it.
  byUserId  String?  @map("by_user_id") @db.Uuid
  // Who the child was handed to, when that is known — the name off a scanned
  // pickup authorisation. Free text, same reasoning as Attendance.checkedOutTo.
  releasedTo String? @map("released_to") @db.VarChar(255)
  at        DateTime @default(now()) @db.Timestamptz(6)

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User     @relation("DoorEventStudent", fields: [studentId], references: [id], onDelete: Cascade)
  by        User?    @relation("DoorEventStaff", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([studentId, at])
  @@index([at])
  @@map("attendance_events")
}

model SessionNote {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  notes        String?
  visibility   String   @default("all") @db.VarChar(20)
  recordingUrl String?  @map("recording_url")
  // "teacher" for what a teacher writes by hand after class; "lesson_plan_summary"
  // for the preview auto-generated the moment an admin approves that week's lesson
  // plan. Kept separate so re-approving can safely replace just its own note
  // without touching anything the teacher wrote themselves.
  source       String   @default("teacher") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_notes")
}

model SessionMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  name       String   @db.VarChar(255)
  fileUrl    String   @map("file_url")
  fileType   String?  @map("file_type") @db.VarChar(50)
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_materials")
}

model Material {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  name       String   @db.VarChar(255)
  subject    String?  @db.VarChar(100)
  type       String?  @db.VarChar(50)
  fileUrl    String   @map("file_url")
  date       DateTime @default(now()) @db.Date
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model SnackItem {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(255)
  costPunches Int             @map("cost_punches")
  // Where the photo lives, when it lives in Drive. Staff add a snack by taking
  // a picture at the cabinet with their phone, and the old path stuffed that
  // picture into imageUrl as a base64 data URI: 11 rows grew to 62 MB, four
  // fifths of the whole database, for photos of granola bars. The bytes go to
  // Drive now and imageUrl holds the API path that streams them back.
  driveFileId String?         @map("drive_file_id")
  imageUrl    String?         @map("image_url")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  purchases   SnackPurchase[]

  @@map("snack_items")
}

model SnackPurchase {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  snackId     String    @map("snack_id") @db.Uuid
  punchesUsed Int       @map("punches_used")
  purchasedAt DateTime  @default(now()) @map("purchased_at") @db.Timestamptz(6)
  snack       SnackItem @relation(fields: [snackId], references: [id])
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("snack_purchases")
}

// A parent-approval request raised the moment a student's snack card hits 0.
// The parent approves/rejects reloading more (paid) punches; front desk only
// tops up + charges once the parent has approved. See rewards.controller.js.
//   PENDING   → created on depletion, awaiting the parent's decision
//   APPROVED  → parent authorized the reload; visible in the front-desk queue
//   REJECTED  → parent declined; nothing charged
//   FULFILLED → front desk added the punches and recorded the CHARGE
model SnackReloadRequest {
  id            String    @id @default(uuid()) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  familyId      String?   @map("family_id") @db.Uuid
  punchCount    Int       @map("punch_count")
  price         Decimal   @db.Decimal(10, 2)
  status        String    @default("PENDING") @db.VarChar(20)
  triggeredById String?   @map("triggered_by") @db.Uuid
  decidedById   String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  fulfilledById String?   @map("fulfilled_by") @db.Uuid
  fulfilledAt   DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  transactionId String?   @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  student     User    @relation("SnackReloadStudent", fields: [studentId], references: [id], onDelete: Cascade)
  family      Family? @relation(fields: [familyId], references: [id])
  decidedBy   User?   @relation("SnackReloadDecidedBy", fields: [decidedById], references: [id])
  fulfilledBy User?   @relation("SnackReloadFulfilledBy", fields: [fulfilledById], references: [id])

  @@index([status])
  @@index([studentId])
  @@map("snack_reload_requests")
}

model PrizeHistory {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  reason    String    @db.VarChar(255)
  points    Int
  type      PrizeType
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("prize_history")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  studentId   String?         @map("student_id") @db.Uuid
  familyId    String?         @map("family_id") @db.Uuid
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  date        DateTime        @default(now()) @db.Date
  // termId + quarter together are set only on tuition raised by the quarterly
  // billing run — the unique index below is what makes that run safe to
  // repeat: a second attempt for the same student and quarter is refused by
  // the database rather than double-charged. Postgres treats NULLs as
  // distinct, so every other transaction is untouched.
  // termId ALONE (quarter left null) marks the registration deposit charge
  // instead — that's what lets cancelling a registration find and reverse it
  // without also sweeping up a quarterly tuition charge for the same term.
  termId      String?         @map("term_id") @db.Uuid
  quarter     Int?
  // Set only on charges raised by a standing monthly arrangement. `periodKey`
  // is the month it covers ("2026-08"); together with the unique index below
  // it is what makes the nightly run safe to repeat or catch up after downtime
  // — a second attempt for the same month is refused by the database instead
  // of charging the family twice. Same trick as termId/quarter above.
  recurringChargeId String?   @map("recurring_charge_id") @db.Uuid
  periodKey         String?   @map("period_key") @db.VarChar(7)
  // Set only on a late-cancellation/no-show fee. Together with the two links
  // above and termId/quarter, this is how the ledger knows what produced a
  // charge and can send an admin to that source to correct it.
  sessionCancellationId String? @map("session_cancellation_id") @db.Uuid
  // Set only on a charge raised from a price typed onto one calendar entry.
  // Same trick as termId/quarter and recurringChargeId/periodKey above: with
  // the unique index below it is what stops one meeting billing the same
  // student twice, however many times an admin re-runs the approval.
  sessionId   String?         @map("session_id") @db.Uuid
  invoiceId   String?         @map("invoice_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  family      Family?         @relation(fields: [familyId], references: [id])
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id])
  payment     Payment?        @relation(fields: [paymentId], references: [id])
  student     User?           @relation(fields: [studentId], references: [id])
  recurringCharge RecurringCharge? @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)
  sessionCancellation SessionCancellation? @relation(fields: [sessionCancellationId], references: [id], onDelete: SetNull)
  session     Session?        @relation("SessionCharges", fields: [sessionId], references: [id], onDelete: SetNull)
  snackReload SnackReloadRequest?
  invoiceLine InvoiceLine?

  @@unique([studentId, termId, quarter])
  @@unique([recurringChargeId, periodKey])
  @@unique([studentId, sessionId])
  @@index([familyId])
  @@index([date])
  @@index([sessionCancellationId])
  @@map("transactions")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  invoiceNumber       String        @unique @map("invoice_number") @db.VarChar(20)
  familyId            String?       @map("family_id") @db.Uuid
  studentId           String?       @map("student_id") @db.Uuid
  date                DateTime      @default(now()) @db.Date
  dateRange           String?       @map("date_range") @db.VarChar(100)
  poNumbers           String[]      @default([]) @map("po_numbers")
  source              String?       @db.VarChar(20)
  subtotal            Decimal       @db.Decimal(10, 2)
  processingFee       Decimal       @default(0) @map("processing_fee") @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  amountPaid          Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  status              InvoiceStatus @default(DRAFT)
  dueDate             DateTime?     @map("due_date") @db.Date
  stripePaymentLink   String?       @map("stripe_payment_link")
  stripePaymentLinkId String?       @map("stripe_payment_link_id") @db.VarChar(255)
  // When the invoice was last emailed out. Null means it has never been sent.
  // `status = SENT` means the invoice was emailed; it stays SENT even after
  // partial payments — only a full payment moves it to PAID.
  sentAt              DateTime?     @map("sent_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Wave accounting sync (see server/src/services/wave.service.js). Set once
  // this invoice has been raised as Accounts Receivable in Wave; waveSyncError
  // holds the last failure so Settings > Integrations can surface it for retry,
  // and is cleared on the next successful sync.
  waveInvoiceId       String?       @map("wave_invoice_id") @db.VarChar(255)
  waveSyncedAt        DateTime?     @map("wave_synced_at") @db.Timestamptz(6)
  waveSyncError       String?       @map("wave_sync_error")
  lines               InvoiceLine[]
  family              Family?       @relation(fields: [familyId], references: [id])
  payments            Payment[]
  transactions        Transaction[]

  @@index([familyId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String       @id @default(uuid()) @db.Uuid
  invoiceId   String       @map("invoice_id") @db.Uuid
  description String
  amount      Decimal      @db.Decimal(10, 2)
  quantity    Int          @default(1)
  // The Transaction this line was raised from — what makes an invoice line
  // editable/removable without guessing which ledger row it corresponds to.
  // Null on lines from before this link existed, or a line an admin added
  // without a backing charge.
  transactionId String?    @unique @map("transaction_id") @db.Uuid
  // A line is what the family is actually shown, and it can be rewritten after
  // the invoice has gone out — by an edit, by a correction to the charge
  // underneath it. Without these an invoice that emailed the wrong amount has
  // no history at all to look at afterwards.
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("invoice_lines")
}

model Payment {
  id                    String                    @id @default(uuid()) @db.Uuid
  familyId              String?                   @map("family_id") @db.Uuid
  invoiceId             String?                   @map("invoice_id") @db.Uuid
  amount                Decimal                   @db.Decimal(10, 2)
  processingFee         Decimal                   @default(0) @map("processing_fee") @db.Decimal(10, 2)
  netAmount             Decimal?                  @map("net_amount") @db.Decimal(10, 2)
  method                PaymentMethod
  status                PaymentStatus             @default(PENDING)
  stripePaymentIntentId String?                   @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId        String?                   @map("stripe_charge_id") @db.VarChar(255)
  stripeReceiptUrl      String?                   @map("stripe_receipt_url")
  externalReference     String?                   @map("external_reference") @db.VarChar(255)
  notes                 String?
  recordedById          String?                   @map("recorded_by") @db.Uuid
  paidAt                DateTime?                 @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Wave accounting sync: set once the payment has been pushed to Wave as an
  // income money-transaction. waveTransactionId is Wave's transaction id; the
  // presence of waveSyncedAt is what makes a re-sync skip this payment.
  waveTransactionId     String?                   @map("wave_transaction_id") @db.VarChar(255)
  waveSyncedAt          DateTime?                 @map("wave_synced_at") @db.Timestamptz(6)
  family                Family?                   @relation(fields: [familyId], references: [id])
  invoice               Invoice?                  @relation(fields: [invoiceId], references: [id])
  recordedBy            User?                     @relation("RecordedByUser", fields: [recordedById], references: [id])
  scholarships          ScholarshipDisbursement[]
  transactions          Transaction[]

  @@index([waveSyncedAt])
  @@map("payments")
}

/// Single-row OAuth connection to the academy's Wave accounting business.
/// Stores encrypted access/refresh tokens plus the mapping of which Wave
/// accounts recorded income should be deposited into (anchor) and categorised
/// under (income). A missing row means "Wave is not connected".
model WaveConnection {
  id                String    @id @default(uuid()) @db.Uuid
  // Wave business the tokens belong to.
  businessId        String?   @map("business_id") @db.VarChar(255)
  businessName      String?   @map("business_name") @db.VarChar(255)
  // AES-GCM encrypted OAuth tokens — never returned to the client.
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  tokenExpiresAt    DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scope             String?   @db.VarChar(255)
  // Account mapping for income transactions (chosen by the admin post-connect).
  anchorAccountId   String?   @map("anchor_account_id") @db.VarChar(255)
  anchorAccountName String?   @map("anchor_account_name") @db.VarChar(255)
