// Admin-wide, per-event configuration for the automated notifications the
// system fires (class reminders, absence alerts, overdue invoices, etc.) — not
// per-user preferences (see NotificationPreference below for that). One row per
// event `eventKey`; rows are created lazily the first time an admin saves an
// override. The canonical event list and defaults live in
// server/src/config/notificationEvents.js — a missing row means "use defaults".
//
//   enabled  — master on/off for the event
//   audience — which recipient groups get it (e.g. ["PARENTS","ADMINS"])
//   channels — how it's delivered (e.g. ["IN_APP","EMAIL","SMS"]); an empty
//              array means "use the catalog default". Recipients can still
//              mute a channel for themselves via NotificationPreference.
//   params   — event-specific tunables as JSON, e.g. { minutesBefore: 15 } for
//              CLASS_REMINDER or { thresholdCount: 3, windowDays: 30 } for
//              REPEATED_ABSENCE. Validated against the catalog before saving.
model NotificationEventConfig {
  id          String   @id @default(uuid()) @db.Uuid
  eventKey    String   @unique @map("event_key") @db.VarChar(50)
  enabled     Boolean  @default(true)
  audience    String[] @default([])
  channels    String[] @default([])
  params      Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by") @db.Uuid

  @@map("notification_event_config")
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  category String  @db.VarChar(50)
  inApp    Boolean @default(true) @map("in_app")
  email    Boolean @default(true)
  push     Boolean @default(false)
  sms      Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("notification_preferences")
}

model Announcement {
  id             String              @id @default(uuid()) @db.Uuid
  title          String              @db.VarChar(255)
  body           String
  authorId       String?             @map("author_id") @db.Uuid
  targetAudience String              @default("all") @map("target_audience") @db.VarChar(20)
  category       String              @default("general") @map("category") @db.VarChar(30)
  imageUrl       String?             @map("image_url")
  isPinned       Boolean             @default(false) @map("is_pinned")
  // 'PENDING' | 'APPROVED' | 'REJECTED'. A teacher's post waits for an admin;
  // an admin's own post is approved as it is written, because the review this
  // exists for has already happened. Rows written before the review existed
  // are APPROVED for the same reason.
  status         String              @default("APPROVED") @db.VarChar(10)
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  // Why it was turned down, in the admin's words. The author sees it, so the
  // post can be fixed rather than rewritten from memory.
  reviewNote     String?             @map("review_note")
  publishedAt    DateTime            @default(now()) @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime?           @map("expires_at") @db.Timestamptz(6)
  author         User?               @relation(fields: [authorId], references: [id])
  reviewedBy     User?               @relation("AnnouncementReviewer", fields: [reviewedById], references: [id])
  reads          AnnouncementRead[]
  media          AnnouncementMedia[]
  comments       AnnouncementComment[]

  @@index([targetAudience])
  @@index([publishedAt])
  @@index([status])
  @@map("announcements")
}

/**
 * A reply on an announcement. Anyone who can see the post can answer it, and
 * the whole thread is visible to that same audience — this is a noticeboard,
 * not a private line, and a question one parent asks is usually one four
 * others were about to. Private matters belong in Chat.
 */
model AnnouncementComment {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@map("announcement_comments")
}

model AnnouncementMedia {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  // Where the bytes actually live. `url` is the local-disk path, which only
  // survives as long as the container does; `driveFileId` is the durable copy
  // and is what the file route reads first. A row with neither is a photo that
  // is already lost.
  url            String
  driveFileId    String?      @map("drive_file_id")
  type           String       @default("image") @db.VarChar(10) // 'image' | 'video'
  position       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_media")
}

model RegistrationTerm {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String                @db.VarChar(255)
  startDate          DateTime              @map("start_date") @db.Date
  endDate            DateTime              @map("end_date") @db.Date
  status             String                @default("upcoming") @db.VarChar(20)
  window1OpensAt     DateTime              @map("window1_opens_at") @db.Timestamptz(6)
  window2OpensAt     DateTime              @map("window2_opens_at") @db.Timestamptz(6)
  window3OpensAt     DateTime              @map("window3_opens_at") @db.Timestamptz(6)
  registrationCloses DateTime              @map("registration_closes") @db.Timestamptz(6)
  regularRate        Decimal               @default(0) @map("regular_rate") @db.Decimal(10, 2)
  anchoredRate       Decimal               @default(0) @map("anchored_rate") @db.Decimal(10, 2)
  // A term is billed in two quarters at the same rate. Q1 runs from startDate;
  // this is when Q2 begins, and so when the quarter's charges are raised again
  // — off the roster as it stands that day, which is what makes an eight-week
  // student or a mid-term class switch come out right.
  quarter2StartsAt   DateTime?             @map("quarter2_starts_at") @db.Timestamptz(6)
  depositDueDate     DateTime?             @map("deposit_due_date") @db.Date
  calendarAssetUrl   String?               @map("calendar_asset_url")
